{
  "name": "@quotesnap/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20 <23"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-migrations.js",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --import tsx --test src/**/*.test.ts",
    "test:integration": "node --import tsx --test --test-concurrency=1 src/integration/**/*.integration.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1023.0",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "openai": "^6.33.0",
    "pg": "^8.13.1",
    "pg-boss": "^12.15.0",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/express": "^5.0.0",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
